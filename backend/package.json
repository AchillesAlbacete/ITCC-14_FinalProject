{
  "name": "freight-flow-backend",
  "version": "1.0.0",
  "description": "Freight-Flow Express REST API (Express + MongoDB) aligned with docs/openapi.yaml",
  "main": "server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "start:memory": "node server.js --memory",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "seed:reset": "node seed.js --reset",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.2"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "^11.3.0"
  }
}
